                        @endcan
                    </div>
                    <div class="nk-tb-col tb-col-md">
                        <span @class(['badge badge-dot', 'bg-success' => $item->is_active, 'bg-light' => ! $item->is_active])>
                            {{ __('{{slug}}::admin.statuses.'.($item->is_active ? 'active' : 'inactive')) }}
                        </span>
                    </div>
                    <div class="nk-tb-col tb-col-lg"><span>{{ $item->updated_at?->format('d M Y H:i') }}</span></div>
