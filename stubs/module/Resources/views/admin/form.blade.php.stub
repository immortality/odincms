                </div>
            </div>

            <div class="col-lg-4">
                <div class="card card-bordered">
                    <div class="card-inner">
                        <x-admin.form.checkbox name="is_active" :label="__('{{slug}}::admin.fields.is_active')" :checked="$item->is_active" />
                        <x-admin.form.input name="sort_order" type="number" min="0" :label="__('{{slug}}::admin.fields.sort_order')" :value="$item->sort_order ?? 0" />
