<?php

use App\Models\User;
use {{namespace}}\Models\{{Model}};

beforeEach(function () {
    $this->useModule('{{slug}}');
});

it('sends guests to the login page', function () {
    $this->get(route('admin.{{slug}}.index'))->assertRedirect(route('login'));
});

it('forbids users without permission', function () {
    $this->actingAs(User::factory()->create())
        ->get(route('admin.{{slug}}.index'))
        ->assertForbidden();
});

it('lists, searches and filters items', function () {
    {{Model}}::factory()->create(['title' => ['en' => 'First item']]);
    {{Model}}::factory()->inactive()->create(['title' => ['en' => 'Hidden item']]);

    $this->actingAsAdmin()->get(route('admin.{{slug}}.index'))
        ->assertOk()
        ->assertSee('First item')
        ->assertSee('Hidden item');

    $this->actingAsAdmin()->get(route('admin.{{slug}}.index', ['search' => 'First']))
        ->assertSee('First item')
        ->assertDontSee('Hidden item');

    $this->actingAsAdmin()->get(route('admin.{{slug}}.index', ['status' => 'inactive']))
        ->assertSee('Hidden item')
        ->assertDontSee('First item');
});

it('creates an item', function () {
    $this->actingAsAdmin()->get(route('admin.{{slug}}.create'))->assertOk();

    $this->actingAsAdmin()
        ->post(route('admin.{{slug}}.store'), [
            'title' => ['en' => 'New item', 'ru' => 'Новая запись', 'ky' => ''],
            'is_active' => '1',
            'sort_order' => '3',
        ])
        ->assertRedirect()
        ->assertSessionHas('success');

    $item = {{Model}}::sole();
    expect($item->getTranslations('title'))->toBe(['en' => 'New item', 'ru' => 'Новая запись'])
        ->and($item->is_active)->toBeTrue()
        ->and($item->sort_order)->toBe(3);
});

it('requires the title in the default locale', function () {
    $this->actingAsAdmin()
        ->post(route('admin.{{slug}}.store'), ['title' => ['en' => '', 'ru' => 'Только русский']])
        ->assertSessionHasErrors('title.en');

    expect({{Model}}::count())->toBe(0);
});

it('updates an item', function () {
    $item = {{Model}}::factory()->create();

    $this->actingAsAdmin()->get(route('admin.{{slug}}.edit', $item))->assertOk();

    $this->actingAsAdmin()
        ->put(route('admin.{{slug}}.update', $item), ['title' => ['en' => 'Renamed'], 'is_active' => '0'])
        ->assertRedirect(route('admin.{{slug}}.edit', $item));

    expect($item->fresh()->title)->toBe('Renamed')
        ->and($item->fresh()->is_active)->toBeFalse();
});

it('soft-deletes an item', function () {
    $item = {{Model}}::factory()->create();

    $this->actingAsAdmin()
        ->delete(route('admin.{{slug}}.destroy', $item))
        ->assertRedirect(route('admin.{{slug}}.index'));

    $this->assertSoftDeleted($item);
});

it('runs bulk actions', function () {
    [$first, $second] = {{Model}}::factory()->count(2)->create();

    $this->actingAsAdmin()
        ->post(route('admin.{{slug}}.bulk'), ['action' => 'deactivate', 'ids' => [$first->id, $second->id]])
        ->assertSessionHas('success');

    expect({{Model}}::where('is_active', true)->count())->toBe(0);
});
