<?php

use Illuminate\Support\Facades\Route;
use {{namespace}}\Http\Controllers\Admin\{{Model}}Controller;

/*
| Loaded under /{admin_prefix}/{{slug}} with the names "admin.{{slug}}.*" and the middleware in
| config('cms.admin_middleware') (web, auth, verified, admin). Each action is authorized by {{Model}}Policy.
*/

Route::controller({{Model}}Controller::class)->group(function () {
    Route::get('/', 'index')->name('index');
    Route::get('/create', 'create')->name('create');
    Route::post('/', 'store')->name('store');
    Route::post('/bulk', 'bulk')->name('bulk');
    Route::get('/{item}/edit', 'edit')->name('edit');
    Route::put('/{item}', 'update')->name('update');
    Route::delete('/{item}', 'destroy')->name('destroy');
});
