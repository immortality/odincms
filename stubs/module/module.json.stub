{
    "name": "{{Title}}",
    "slug": "{{slug}}",
    "version": "1.0.0",
    "description": {
        "en": "{{Title}} module"
    },
    "core": false,
    "provider": "Modules\\{{Name}}\\Providers\\{{Name}}ServiceProvider",
